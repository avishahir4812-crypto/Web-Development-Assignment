<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }
         body{
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .logo-container{
            display:flex;
            border: solid 2px #ccc;
            border-radius: 10px;
            overflow:hidden;
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            margin: auto;
            padding: 60px;
            width: auto;
            justify-content: space-evenly;
            
        }
        .logo-container img{
            width: auto;
            height: 90px;
            border-radius: 20px;
            transition: 0.3s;
            cursor: pointer;
        }
        .img{
            width: 90px;
            height: 90px;
            border-radius: 20px;
            transition: 0.3s;
            cursor: pointer;
            justify-content: space-evenly;
        }
        .logo-container img:hover{
            transform: scale(1.2);
        }
        
    </style>
</head>
<body>
    <div class="logo-container">
        <img src="/images/instagram.png" alt="instagram" width="100">
        <img src="/images/facebook.png" alt="facebook" width="100">
        <img src="/images/whatsapp.png" alt="whatsapp" width="100">
        <img src="/images/linkedin.png" alt="linkedin" width="100">
    </div>
</body>
</html>